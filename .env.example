# URL publique du site (balises Open Graph)
NEXT_PUBLIC_SITE_URL=https://live.benjaminphoto.space

# --- WebinarJam (côté serveur, jamais exposé au navigateur) ---
WEBINARJAM_API_KEY=
WEBINARJAM_WEBINAR_ID=
# Identifiant(s) de session, séparés par des virgules. Si les 2 soirées sont
# 2 sessions distinctes, mettre les 2 : la personne est inscrite aux deux.
WEBINARJAM_SCHEDULE_IDS=
# Lien du live utilisé dans l'agenda si WebinarJam ne renvoie pas de lien personnel
NEXT_PUBLIC_WEBINAR_LIVE_URL=

# --- systeme.io : contact + tag (le tag déclenche l'email de confirmation) ---
# Clé : systeme.io > Paramètres > Clés API publiques
SYSTEMEIO_API_KEY=
# Identifiant numérique du tag à poser (ex. « Live boudoir octobre 2026 »)
SYSTEMEIO_TAG_ID=

# --- Stockage des inscrits + UTM (webhook JSON : Make, Zapier, Apps Script…) ---
LEADS_WEBHOOK_URL=
# Envoyé dans l'en-tête X-Webhook-Secret, à vérifier côté réception
LEADS_WEBHOOK_SECRET=

# --- Meta (facultatif) ---
NEXT_PUBLIC_META_PIXEL_ID=          # facultatif : 1031384306524044 par défaut
META_PIXEL_ID=                      # facultatif : même valeur par défaut côté serveur
META_CAPI_TOKEN=                    # jeton de l'API Conversions (obligatoire pour l'envoi serveur)
META_TEST_EVENT_CODE=               # uniquement pour tester dans le Gestionnaire d'événements, à retirer ensuite

# --- Page merci ---
# Lien d'invitation du groupe WhatsApp privé (bouton de la page merci).
NEXT_PUBLIC_WHATSAPP_URL=

# --- Pages légales ---
# Email de contact affiché dans les mentions légales et la politique de confidentialité. Vide = ligne masquée.
NEXT_PUBLIC_EMAIL_CONTACT=
