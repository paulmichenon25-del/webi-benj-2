# URL publique du site (balises Open Graph)
NEXT_PUBLIC_SITE_URL=https://live.fineart-academie.com

# --- WebinarJam (côté serveur, jamais exposé au navigateur) ---
WEBINARJAM_API_KEY=
WEBINARJAM_WEBINAR_ID=
# Identifiant(s) de session, séparés par des virgules. Si les 2 soirées sont
# 2 sessions distinctes, mettre les 2 : la personne est inscrite aux deux.
WEBINARJAM_SCHEDULE_IDS=
# Lien du live utilisé dans l'agenda si WebinarJam ne renvoie pas de lien personnel
NEXT_PUBLIC_WEBINAR_LIVE_URL=

# --- Stockage des inscrits + UTM (webhook JSON : Make, Zapier, Apps Script…) ---
LEADS_WEBHOOK_URL=
# Envoyé dans l'en-tête X-Webhook-Secret, à vérifier côté réception
LEADS_WEBHOOK_SECRET=

# --- Meta (facultatif) ---
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_TOKEN=
# À renseigner uniquement pour tester dans le Gestionnaire d'événements
META_CAPI_TEST_EVENT_CODE=

# --- Page merci ---
# Lien du groupe / de la chaîne WhatsApp de rappel. Vide = bloc masqué.
NEXT_PUBLIC_WHATSAPP_URL=
